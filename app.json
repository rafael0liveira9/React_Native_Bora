{
  "expo": {
    "name": "FRONT_BORA",
    "slug": "eaibora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/eai-bora/logo/logo-main.png",
    "scheme": "frontbora",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF3131",
        "foregroundImage": "./assets/images/eai-bora/logo/logo-main.png"
      },
      "package": "com.rafaopp.eaibora",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/eai-bora/logo/logo-main.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/eai-bora/logo/logo-main.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF3131",
          "dark": {
            "backgroundColor": "#FF3131"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ae41aa0e-b143-48b9-adcf-60b85745660f"
      }
    },
    "owner": "rafaopp"
  }
}
